// Product Master — schema (Phase 0)
// See docs/product-master-architecture.md §4 for the design rationale.
// Runtime connects via a driver adapter (src/lib/db.ts); the CLI reads the
// connection URL from prisma.config.ts. Nothing here touches the live-Shopify
// screens — this is the new master store.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Reference entities
// ---------------------------------------------------------------------------

model Brand {
  id        String         @id @default(cuid())
  name      String         @unique // "Livid", external brand names
  isLivid   Boolean        @default(false)
  gender    String? // default gender for the brand's styles
  // The token this brand uses in SKUs, when the abbreviation rule does not
  // produce it. Required, not decorative: abbreviate("Vintage", 4) gives VNTG,
  // but the corpus writes EXT-VN-; Paraboot is PB in every one of its rows
  // while the rule gives PRBT. Null means derive. Seed it from what a brand
  // already uses, never a guess — a new style SKU is never rewritten
  // (roadmap 2.2), so a wrong token diverges that brand permanently.
  skuToken  String?
  styles    Style[]
  colorways Colorway[]
  template  BrandTemplate?
  drafts    ProductDraft[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model Manufacturer {
  id           String          @id @default(cuid())
  threadflowId String?         @unique // Threadflow manufacturer_id (stable external key)
  name         String
  addrLine1    String?
  addrLine2    String?
  zip          String?
  city         String?
  country      String?
  colorways    Colorway[]
  templates    BrandTemplate[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

// Defaults for creating new products under a brand (plan §6). External brands
// (footwear, accessories, scents, home…) reuse a saved template so only the
// per-product bits are entered; customs defaults here flow to Loom.
model BrandTemplate {
  id                  String        @id @default(cuid())
  brandId             String        @unique
  brand               Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  category            String?
  gender              String?
  unisex              Boolean       @default(false)
  channels            Channel[]     @default([])
  hsCode              String?
  customsDescription  String?
  weightKg            Decimal?      @db.Decimal(8, 3)
  fiberComposition    String?
  countryOfOrigin     String?
  manufacturerId      String?
  manufacturer        Manufacturer? @relation(fields: [manufacturerId], references: [id])
  // DEPRECATED — superseded by defaultSizeSystem. Kept populated so the old
  // brand-product-builder and buildProductsForBrand keep working through the
  // cutover; read through resolveBrandSizes(). Drop the column only once every
  // row is empty.
  sizes               String[]      @default([]) // default size set, e.g. XS,S,M,L,XL or 39-45
  defaultSizeSystemId String?
  defaultSizeSystem   SizeSystem?   @relation(fields: [defaultSizeSystemId], references: [id])
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
}

// ---------------------------------------------------------------------------
// Size systems
// ---------------------------------------------------------------------------

/// A named, ordered size run — "EU shoes 39-46", "Alpha", "One size",
/// "Jeans W/L". Editable after creation: a size is ARCHIVED, never deleted, and
/// `Variant` stores plain strings with no FK here, so neither archiving nor
/// deleting an entry can orphan a garment that was minted from it.
model SizeSystem {
  id        String            @id @default(cuid())
  name      String            @unique
  kind      SizeSystemKind    @default(ONE_D)
  note      String?
  archived  Boolean           @default(false)
  entries   SizeSystemEntry[]
  templates BrandTemplate[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

enum SizeSystemKind {
  ONE_D // S/M/L, 39..46, 9..12.5
  TWO_D // waist x length
  ONE_SIZE // exactly one entry, OS
}

/// One size. Carries exactly what a Variant would, PLUS the token the SKU uses —
/// and the difference is load-bearing:
///
///   sizeLabel "W32/L34"  dim1 "32"  dim2 "34"  skuToken "3234"
///   sizeLabel "9.5"      dim1 "9.5" dim2 null  skuToken "9.5"
///
/// 2-D sizes MUST spell as a trailing four-digit token. Both importers parse
/// `/^\d{4}$/` as waist+length (threadflow/sync.ts deriveSize, cin7/import.ts)
/// and parseSku treats it as a size; `-W32-L32` would make a new 2-D garment
/// invisible to duplicate detection and to both importers. The token is stored
/// rather than derived because abbreviate("9.5") returns "95", so a size must
/// never pass through it, and because one odd size can then be corrected
/// without a code change.
model SizeSystemEntry {
  id           String     @id @default(cuid())
  sizeSystemId String
  sizeSystem   SizeSystem @relation(fields: [sizeSystemId], references: [id], onDelete: Cascade)
  sizeLabel    String
  dim1         String
  dim2         String?
  skuToken     String
  position     Int
  archived     Boolean    @default(false)
  createdAt    DateTime   @default(now())

  @@unique([sizeSystemId, sizeLabel])
  @@index([sizeSystemId, position])
}

// ---------------------------------------------------------------------------
// Product drafts — the creation wizard's state
// ---------------------------------------------------------------------------

/// A creation session that survives a crash, a deploy or a closed laptop.
///
/// The payload is ONE JSON document rather than a normalised shadow of
/// Style/Colorway/Variant, because a half-entered product is not a product: it
/// has no SKU yet, sometimes no style, sometimes no brand. Normalising it would
/// mean nullable everything plus a second set of unique indexes fighting the
/// real ones. The real indexes on styleSku / colorwaySku / variantSku / barcode
/// stay the only idempotency backstop; see finalize.ts.
model ProductDraft {
  id            String             @id @default(cuid())
  title         String // "Paraboot — 3 colourways", for the drafts list
  status        ProductDraftStatus @default(DRAFT)
  /// Which step to reopen on: brand | style | colorways | sizes | prices |
  /// barcodes | review.
  step          String             @default("brand")
  /// Payload shape version. Drafts outlive deploys, so parseDraftPayload()
  /// migrates forward or refuses rather than crashing on a field that moved.
  schemaVersion Int                @default(1)
  /// Compare-and-swap token for autosave. A PUT carrying a stale revision is
  /// rejected, so a second tab cannot silently overwrite the first.
  revision      Int                @default(0)
  payload       Json

  brandId  String?
  brand    Brand?    @relation(fields: [brandId], references: [id])
  seasonId String?
  season   Season?   @relation(fields: [seasonId], references: [id])
  /// What this draft will publish to. Per-channel push OUTCOME is not stored
  /// here — ChannelPublication and VariantChannelRef already model it, and a
  /// retry reads them back through createdColorwayIds. A second record of one
  /// fact is how the two drift.
  channels Channel[] @default([])

  /// Every id minted at the DRAFT -> FINALIZING claim, so a retry reuses them
  /// and the resume probe has something definite to look for.
  reservedIds        Json?
  finalizeAttempts   Int       @default(0)
  startedFinalizeAt  DateTime?
  finalizeError      String?
  completedAt        DateTime?
  createdStyleIds    String[]  @default([])
  createdColorwayIds String[]  @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, updatedAt])
}

enum ProductDraftStatus {
  DRAFT // being edited
  FINALIZING // claimed; ids reserved; the transaction may or may not have committed
  COMPLETED // rows exist in the master
  DISCARDED // abandoned. Never deleted — an allocated barcode needs a paper trail
}

model Season {
  id           String         @id @default(cuid())
  code         String         @unique // "SS27", "FW26"
  name         String?
  threadflowId String?        @unique // maps to TF seasonId
  kind         SeasonKind     @default(REGULAR) // REGULAR | CONTINUITY (carry-over / season-less)
  sortOrder    Int            @default(0)
  entries      SeasonEntry[]
  prices       Price[]
  seasonImages SeasonImage[]
  drafts       ProductDraft[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

// ---------------------------------------------------------------------------
// Product hierarchy: Style -> Colorway -> Variant
// ---------------------------------------------------------------------------

model Style {
  id                 String     @id @default(cuid())
  source             Source // THREADFLOW | MANUAL | SHOPIFY_IMPORT
  threadflowId       String?    @unique
  styleSku           String     @unique
  styleName          String
  gender             String?
  unisex             Boolean    @default(false)
  category           String     @default("Uncategorized")
  brandId            String?
  brand              Brand?     @relation(fields: [brandId], references: [id])
  // Customs block (TF exposes these at style level; Loom wants them per
  // colorway — store the default here, allow a per-colorway override).
  hsCode             String?
  customsDescription String?
  weightKg           Decimal?   @db.Decimal(8, 3) // kg — see plan §11.5
  fiberComposition   String?
  colorways          Colorway[]
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([brandId])
}

model Colorway {
  id              String        @id @default(cuid())
  source          Source
  threadflowId    String?       @unique
  colorwaySku     String        @unique
  name            String
  color           String?
  swatchHex       String?
  swatchImageUrl  String?
  productType     String?
  styleId         String
  style           Style         @relation(fields: [styleId], references: [id])
  brandId         String? // Loom needs brand per product (externals)
  brand           Brand?        @relation(fields: [brandId], references: [id])
  manufacturerId  String?
  manufacturer    Manufacturer? @relation(fields: [manufacturerId], references: [id])
  countryOfOrigin String?

  // ---- Product properties (carried over from today's editor) ----
  status ProductStatus @default(DRAFT)
  tags   String[]
  vendor String?

  // What this record is. Anything other than MERCHANDISE is excluded from stock
  // gates, channel pushes and import allowlists.
  kind ProductKind @default(MERCHANDISE)

  // A CORE product is a permanent production line, carried every season by
  // design (as opposed to a seasonal product). Set from the CORE/Allseasons
  // tags or manually; durable across seasons.
  isCore Boolean @default(false)

  // ---- Optional customs overrides (else inherit from Style) ----
  hsCodeOverride             String?
  customsDescriptionOverride String?
  weightKgOverride           Decimal? @db.Decimal(8, 3)
  fiberCompositionOverride   String?

  // ---- Enrichment: the full custom.* metafield set, authored in the master ----
  // Free text:
  shortDescription        String?
  fullDescription         String?
  details                 String?
  styleTagline            String?
  styleName               String?
  // Reference metafields (store target GIDs / ids; edited via the pickers):
  sameProduct             String[] // list.product_reference — group auto-link
  styleWith               String[] // list.product_reference
  styleWithUnisexHerre    String[] // list.product_reference
  styleWithUnisexDame     String[] // list.product_reference
  carePageId              String? // page_reference (care picker)
  fitguidePageId          String? // page_reference (fitguide picker)
  recommendedCollectionId String? // collection_reference
  modelInfoId             String? // metaobject_reference (fit model)
  flatFileId              String? // file_reference (flat-lay)
  menImages               String[] // list.file_reference (unisex)
  womenImages             String[] // list.file_reference (unisex)

  // ---- Relations ----
  media          MediaAsset[]
  variants       Variant[]
  entries        SeasonEntry[]
  prices         Price[]
  publications   ChannelPublication[]
  channelContent ChannelContent[]
  seasonImages   SeasonImage[]

  archived  Boolean  @default(false) // whole-channel archive (plan §8)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([styleId])
  @@index([brandId])
  @@index([manufacturerId])
}

model Variant {
  id             String              @id @default(cuid()) // stable id — TF has none, we mint it
  colorwayId     String
  colorway       Colorway            @relation(fields: [colorwayId], references: [id], onDelete: Cascade)
  variantSku     String              @unique
  barcode        String?             @unique // set once, never blanked (plan §5.2); canonical EAN-13
  sizeLabel      String // "M" or "W32/L32"
  dim1           String // "M" or waist "32"
  dim2           String? // length "32" for 2-D
  averageCostNok Decimal?            @db.Decimal(14, 2) // written back from Loom (plan §9)
  seasonLinks    SeasonVariant[]
  channelRefs    VariantChannelRef[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([colorwayId])
}

// ---------------------------------------------------------------------------
// Per-season data
// ---------------------------------------------------------------------------

model SeasonEntry {
  id                    String          @id @default(cuid())
  colorwayId            String
  seasonId              String
  colorway              Colorway        @relation(fields: [colorwayId], references: [id], onDelete: Cascade)
  season                Season          @relation(fields: [seasonId], references: [id])
  cancelled             Boolean         @default(false) // = Threadflow "dropped" (plan §8)
  approvedForProduction Boolean         @default(false)
  // How this product entered THIS season: NEW = its origin season; CARRYOVER =
  // pulled forward from an earlier season. (CORE is a product-level trait; see
  // Colorway.isCore.) Relative to the season, so it lives on the entry.
  origin                EntryOrigin     @default(NEW)
  // Which delivery of the season this product belongs to ("Drop 1", "Drop 2").
  // A drop is a slice of ONE season, so it lives on the entry rather than the
  // colorway — the same garment can land in different drops across seasons.
  // Free text so merchandising can name them without a migration.
  drop                  String?
  merchPosition         Int? // preserved across cancel/restore
  variants              SeasonVariant[]

  @@unique([colorwayId, seasonId])
  @@index([seasonId])
  @@index([seasonId, drop])
}

model SeasonVariant {
  seasonEntryId String
  variantId     String
  seasonEntry   SeasonEntry @relation(fields: [seasonEntryId], references: [id], onDelete: Cascade)
  variant       Variant     @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@id([seasonEntryId, variantId])
  @@index([variantId])
}

model Price {
  id         String    @id @default(cuid())
  seasonId   String
  colorwayId String
  season     Season    @relation(fields: [seasonId], references: [id])
  colorway   Colorway  @relation(fields: [colorwayId], references: [id], onDelete: Cascade)
  currency   String // "NOK" | "EUR" | "USD"
  priceType  PriceType // MSRP | WHOLESALE
  amount     Decimal   @db.Decimal(14, 2)

  @@unique([seasonId, colorwayId, currency, priceType])
  @@index([colorwayId])
}

model SeasonImage {
  id            String    @id @default(cuid())
  seasonId      String
  colorwayId    String
  season        Season    @relation(fields: [seasonId], references: [id])
  colorway      Colorway  @relation(fields: [colorwayId], references: [id], onDelete: Cascade)
  slot          ImageSlot // MAIN | ALT
  url           String
  shopifyFileId String? // GID once uploaded to Shopify (reused on re-push)

  @@unique([seasonId, colorwayId, slot])
  @@index([colorwayId])
}

model MediaAsset {
  id             String      @id @default(cuid())
  colorwayId     String
  colorway       Colorway    @relation(fields: [colorwayId], references: [id], onDelete: Cascade)
  url            String // Blob URL (owned) or external ref (Shopify CDN / Threadflow)
  source         MediaSource @default(BLOB)
  role           MediaRole   @default(GALLERY) // maps to Shopify file metafields on push
  blobPathname   String? // set when owned in Blob, so we can delete the object
  alt            String?
  mediaType      String      @default("IMAGE") // IMAGE | VIDEO | MODEL_3D
  position       Int // sort order for reorder
  shopifyMediaId String? // GID once pushed to Shopify

  @@index([colorwayId])
}

// ---------------------------------------------------------------------------
// Channels, content overrides, lifecycle
// ---------------------------------------------------------------------------

model ChannelPublication {
  id             String    @id @default(cuid())
  colorwayId     String
  colorway       Colorway  @relation(fields: [colorwayId], references: [id], onDelete: Cascade)
  channel        Channel // SHOPIFY | LOOM
  published      Boolean   @default(false)
  externalId     String? // Shopify product GID / Loom key once pushed
  lastPushedAt   DateTime?
  lastPushStatus String?

  @@unique([colorwayId, channel])
}

model ChannelContent {
  id         String   @id @default(cuid())
  colorwayId String
  colorway   Colorway @relation(fields: [colorwayId], references: [id], onDelete: Cascade)
  channel    Channel // SHOPIFY (B2C) | LOOM (B2B)
  field      String // e.g. "fullDescription", "styleWith", "tags"
  value      String // scalar, or JSON-encoded list for list fields

  @@unique([colorwayId, channel, field])
}

// ---------------------------------------------------------------------------
// Sync infrastructure (field ownership + audit)
// ---------------------------------------------------------------------------

model FieldOwner {
  id         String    @id @default(cuid())
  entityType String // "style" | "colorway" | "variant"
  entityId   String
  field      String
  owner      Source // how the value arrived (provenance)
  lockedAt   DateTime?

  // Who decided the value, when Source is too coarse to say. Source records the
  // pipeline that carried it; these record the authority that settled it —
  // "cfo-list-2026-09-11", "sitoo", "manual:scan". Needed to answer "why does
  // this say X?" after a reconciliation.
  authority String?
  evidence  String?
  decidedAt DateTime?

  @@unique([entityType, entityId, field])
  @@index([entityType, entityId])
}

model SyncRun {
  id         String    @id @default(cuid())
  source     String // "threadflow" | "shopify-import" | "loom-cost"
  mode       String // "full" | "prices-only" | "no-images" | ...
  seasonCode String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  status     String // "running" | "ok" | "partial" | "failed"
  counts     Json?
  // Real failures only. Informational notes (SKU renames, parked duplicates)
  // live in `warnings`, and deliberately-unwritten items in `skipped` — mixing
  // them into `errors` made a healthy run look broken and buried the real
  // message. Historic rows predate the split and still have notes in `errors`.
  errors     Json?
  warnings   Json?
  skipped    Json?
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Identity allocation and channel linkage
// ---------------------------------------------------------------------------

// The ledger of issued barcodes. Every Livid barcode is
// `range + zero-padded sequence + EAN-13 check digit` (verified against all
// 9,822 rows of the CFO list). Two series run in parallel: 7072536 for
// production, 7000000 for samples, sale buckets and other non-production rows.
// Origio holds the ledger so allocation is `max(sequence) + 1` and so the
// unique index on Variant.barcode has something to check against.
model BarcodeAllocation {
  id        String   @id @default(cuid())
  range     String // GS1 prefix, e.g. "7072536"
  sequence  Int // the CFO list's "Product Code"
  barcode   String   @unique // full canonical EAN-13
  sku       String? // what it was issued for, when known
  authority String // "cfo-list-2026-09-11" | "origio" | ...
  issuedAt  DateTime @default(now())

  @@unique([range, sequence])
  @@index([sku])
}

// Per-variant channel identity. ChannelPublication is colorway-level with a
// single externalId, which is right for a Shopify product but not for Sitoo
// (one record per SKU) or for the Loom stock registry (movements are per
// variant). Seeded by matching, never by creating.
model VariantChannelRef {
  id                  String    @id @default(cuid())
  variantId           String
  variant             Variant   @relation(fields: [variantId], references: [id], onDelete: Cascade)
  channel             Channel
  externalId          String // Sitoo productid, Loom variant key
  /**
   * What the channel calls this garment, when that differs from the master.
   * Null means the spellings agree. A value is an ALIAS, not a second identity:
   * Shopify holds LIV-KRI-DWN-2432 for what the master calls
   * LIV-KR-JPN-DWN-2432 — one garment, renamed in one place and not the other.
   * Recorded rather than merged. A merge is for two records of one garment
   * inside the master; across systems there is one record and two names, and
   * the name the channel uses has to stay known until the master asserts its
   * own and the alias becomes history.
   */
  externalSku         String?
  /**
   * A SECOND id the channel uses for the same garment, when identity and stock
   * are different objects there.
   * Shopify is the case this exists for. `externalId` holds the ProductVariant
   * gid, which is what a listing is; inventory moves against an InventoryItem,
   * which is a different gid entirely:
   * externalId          gid://shopify/ProductVariant/42591569969401
   * externalInventoryId gid://shopify/InventoryItem/44686936178937
   * Loom's stock registry joins on the inventory object, so a registry that
   * carried only the ProductVariant would be reconciling against the wrong one.
   * Null where the channel has no such split (Sitoo), or where we simply have
   * no link — the registry falls back to barcode there.
   */
  externalInventoryId String?
  lastPushedAt        DateTime?
  lastPushStatus      String?

  @@unique([variantId, channel])
  @@index([channel, externalId])
  // Declared to match reality: migration 20260911160000 created this index and
  // the model never named it, so every `migrate diff` since has reported drift
  // and would have offered to DROP it. No DDL — the index already exists.
  @@index([externalSku])
}

enum Source {
  THREADFLOW
  MANUAL
  SHOPIFY_IMPORT
  CIN7_IMPORT
}

enum SeasonKind {
  REGULAR
  CONTINUITY
}

enum EntryOrigin {
  NEW // this product's origin (first) season
  CARRYOVER // carried forward from an earlier season
}

enum PriceType {
  MSRP
  WHOLESALE
  COST // what Livid pays. Entered in the builder; season-scoped like the rest,
  //      because a re-buy can land at a different cost.
}

enum ImageSlot {
  MAIN
  ALT
}

enum Channel {
  SHOPIFY
  LOOM
  SITOO
}

// What a record *is*, as opposed to where it came from (Source). Lives in the
// model rather than in reconciliation scripts, because every consumer of the
// master needs the same distinction — stock figures, channel eligibility and
// import gates are all wrong without it.
enum ProductKind {
  MERCHANDISE // a sellable individual garment — the default
  AGGREGATE // one SKU standing for many items: sale buckets, vintage bulk lots
  MATERIAL // production input: fabric, buttons, trims
  CONSUMABLE // hangers, packaging — not merchandise
  SAMPLE // showroom / press samples
  SERVICE // repairs, alterations, shipping line items
  TEST // test data that reached a live system
}

enum ProductStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

enum MediaSource {
  BLOB // owned in Vercel Blob
  SHOPIFY // referenced from Shopify CDN
  THREADFLOW // referenced via the Threadflow image proxy
  EXTERNAL // any other absolute URL
}

enum MediaRole {
  GALLERY // normal product image
  FLAT // custom.flat (flat-lay)
  MEN // custom.men_images (unisex)
  WOMEN // custom.women_images (unisex)
  SWATCH // colour swatch
}
